{
  "name": "orderwise",
  "version": "0.1.0",
  "private": true,
  "description": "Orderwise - An AI-Powered Sales Assistant for Small Shops",
  "packageManager": "pnpm@10.34.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "bcrypt",
      "bcryptjs",
      "@nestjs/core"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "infra:up": "docker compose up --build -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "db:generate": "pnpm --filter @orderwise/prisma db:generate",
    "db:migrate": "pnpm --filter @orderwise/prisma db:migrate",
    "db:studio": "pnpm --filter @orderwise/prisma db:studio",
    "dev:api": "pnpm --filter @orderwise/api dev",
    "dev:web": "pnpm --filter @orderwise/web dev",
    "dev": "concurrently -n api,web -c blue,green \"pnpm dev:api\" \"pnpm dev:web\"",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  }
}
