# Orderwise API environment — local development
NODE_ENV=development
PORT=4010

# Postgres with pgvector
DATABASE_URL="postgresql://orderwise:orderwise@localhost:5432/orderwise?schema=public"

# Redis (cache + BullMQ queues + stock-hold timeouts)
REDIS_URL="redis://localhost:6379"
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# CORS
CORS_ORIGIN=http://localhost:3000
# Cloudinary (images) — set for real usage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# LLM / embeddings — e.g. OpenAI-compatible endpoint (DeepSeek, OpenRouter, vLLM).
# Leave LLM_API_KEY EMPTY to run the deterministic Mock provider (no cost, used
# by scripts/ai-e2e.js and local dev so the whole intent pipeline still runs E2E).
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL="gpt-4o-mini"

# Embeddings (RAG). Same key as LLM when both come from one provider.
# EMBEDDING_DIM MUST match the pgvector column width (vector(1024)) — do NOT
# change without a migration. None of text-embedding-3-small's dims fit 1024
# exactly, so for real semantic search you may need to adjust the schema.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIM=1024

# BullMQ workers (hold-timeout expiry + sweep, delivery retry, embeddings).
# Set AI_WORKERS=0 to disable workers in this process (e.g. when running the
# worker in a separate process).
AI_WORKERS=1
AI_INTENT_TTL_MS=900000
