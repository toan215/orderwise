# Orderwise API environment — local development
NODE_ENV=development
PORT=4010

# Postgres with pgvector
DATABASE_URL="postgresql://orderwise:orderwise@localhost:5432/orderwise?schema=public"

# Redis (cache + BullMQ queues + stock-hold timeouts)
REDIS_URL="redis://localhost:6379"
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# CORS
CORS_ORIGIN=http://localhost:3000
# Cloudinary (images) — set for real usage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# LLM / embeddings — e.g. OpenAI-compatible endpoint
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL="gpt-4o-mini"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIM=1536
